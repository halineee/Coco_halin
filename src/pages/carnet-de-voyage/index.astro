---
import titleArt from '../../assets/illustrations/titres/carnet-de-voyage.svg';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTitle from '../../components/PageTitle.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CarnetMap from '../../components/CarnetMap.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import Icon from '../../components/Icon.astro';
import rawContent from '../../content/carnet.yaml';
import rawFood from '../../content/a-table.yaml';
import { fr } from '../../lib/text';
import { url } from '../../lib/url';

const content = fr(rawContent);
const food = fr(rawFood);
const bref = content.bref;
---

<BaseLayout title={content.pageTitle} description={content.intro}>
  <PageTitle title={content.pageTitle} art={titleArt} intro={content.intro} />

  <section class="map-block container container--wide" aria-label="Carte des destinations">
    <div data-reveal>
      <CarnetMap />
    </div>
    <p class="hint">{content.mapHint}</p>
  </section>

  <section class="block container container--wide">
    <SectionHeading title={content.foodTitle} />
    <div class="food">
      <DestinationCard
        href={url('/carnet-de-voyage/a-table/')}
        label={food.tagline}
        name={food.title}
        korean={food.korean}
        text={food.cardText}
        image={food.hero}
      />
    </div>
  </section>

  <section class="block container container--wide" aria-labelledby="bref">
    <SectionHeading id="bref" title={bref.title} text={bref.text} />
    <div class="facts">
      {
        bref.items.map((item: any) => (
          <div class="fact" data-reveal>
            <span class="fact-icon">
              <Icon name={item.icon} size={26} strokeWidth={1.2} />
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="culture" data-reveal>
      <h3 class="script">{bref.culture.title}</h3>
      <ul>
        {bref.culture.items.map((line: string) => <li>{line}</li>)}
      </ul>
    </div>

    <div class="words" data-reveal>
      <h3 class="script">{bref.mots.title}</h3>
      <dl>
        {
          bref.mots.items.map((w: any) => (
            <div>
              <dt>{w.fr}</dt>
              <dd>
                <span class="ko" lang="ko">
                  {w.ko}
                </span>
                <span class="say">{w.say}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .map-block {
    padding-top: var(--space-md);
  }

  .hint {
    margin-top: var(--space-md);
    text-align: center;
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }

  .block {
    padding-top: var(--space-2xl);
  }

  .food {
    max-width: 34rem;
    margin-top: var(--space-md);
  }

  .facts {
    display: grid;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .fact {
    display: flex;
    gap: var(--space-sm);
    padding: var(--space-md);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-card);
  }

  .fact-icon {
    flex: none;
    color: var(--color-ink-soft);
  }

  .fact h3 {
    font-size: 1.05rem;
    font-weight: 400;
  }

  .fact p {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .culture,
  .words {
    margin-top: var(--space-xl);
  }

  .culture h3,
  .words h3 {
    font-size: var(--text-script-sm);
  }

  .culture ul {
    display: grid;
    gap: 0.5rem;
    margin: var(--space-sm) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .culture li {
    position: relative;
    padding-left: 1.1rem;
    line-height: 1.6;
  }

  .culture li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.55rem;
    height: 1px;
    background: var(--color-ink-soft);
  }

  .words dl {
    margin: var(--space-sm) 0 0;
  }

  .words dl div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-sm);
    align-items: baseline;
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-line);
  }

  .words dt {
    font-size: var(--text-sm);
  }

  .words dd {
    margin: 0;
    text-align: right;
  }

  .ko {
    display: block;
    font-size: 1.05rem;
  }

  .say {
    display: block;
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--color-ink-soft);
  }

  @media (min-width: 48em) {
    .facts {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
