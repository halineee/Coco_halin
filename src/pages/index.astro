---
import BaseLayout from '../layouts/BaseLayout.astro';
import PolaroidHero from '../components/PolaroidHero.astro';
import EventDetails from '../components/EventDetails.astro';
import VenueSection from '../components/VenueSection.astro';
import Countdown from '../components/Countdown.astro';
import Faq from '../components/Faq.astro';
import Rsvp from '../components/Rsvp.astro';
import site from '../content/site.yaml';

const { wedding, home } = site;
---

<BaseLayout>
  <PolaroidHero />
  <EventDetails />
  <VenueSection />
  <Faq />
  <Rsvp />
  <Countdown
    datetime={wedding.datetime}
    before={home.countdownBefore}
    after={home.countdownAfter}
    today={home.countdownToday}
  />
  <p class="bottom-hint container" data-reveal>{home.bottomHint}</p>
</BaseLayout>

<style>
  .bottom-hint {
    padding-top: var(--space-2xl);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
</style>
