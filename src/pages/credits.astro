---
// Crédits des photos libres de droits utilisées sur le site.
// La liste est dans src/content/credits.yaml.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import credits from '../content/credits.yaml';

const photos: { path: string; title: string; author: string; license: string; licenseUrl: string; source: string }[] =
  credits?.photos ?? [];
---

<BaseLayout title="Crédits photos">
  <PageTitle
    title="Crédits photos"
    intro="Les photos de lieux et de plats proviennent de Wikimedia Commons et sont publiées sous licence libre. Merci à leurs auteurs."
  />
  <div class="container container--wide">
    <ul class="credits">
      {
        photos.map((p) => (
          <li>
            <a href={p.source} target="_blank" rel="noopener noreferrer">
              {p.title}
            </a>
            <span>
              {p.author} ·{' '}
              {p.licenseUrl ? (
                <a href={p.licenseUrl} target="_blank" rel="noopener noreferrer">
                  {p.license}
                </a>
              ) : (
                p.license
              )}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .credits {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .credits li {
    display: grid;
    gap: 0.15rem;
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-line);
    overflow-wrap: anywhere;
  }

  .credits span {
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }
</style>
