---
// Bouton « Haut » : un en bas de page (comme dans Canva) et un petit
// bouton flottant qui apparaît lorsqu'on a bien défilé.
import Icon from './Icon.astro';
---

<a href="#top" class="back-to-top" data-back-to-top>
  <span class="circle"><Icon name="arrow-up" size={22} strokeWidth={1.4} /></span>
  <span class="label script">Haut</span>
</a>

<a href="#top" class="back-to-top-float" data-back-to-top data-float aria-label="Revenir en haut de la page" hidden>
  <Icon name="arrow-up" size={18} strokeWidth={1.5} />
</a>

<script>
  const float = document.querySelector<HTMLElement>('[data-float]');
  const footer = document.querySelector('.site-footer');
  if (float) {
    float.hidden = false;
    let footerVisible = false;
    const update = () => {
      const show = window.scrollY > window.innerHeight * 1.5 && !footerVisible;
      float.classList.toggle('is-shown', show);
    };
    if (footer) {
      new IntersectionObserver(([entry]) => {
        footerVisible = entry.isIntersecting;
        update();
      }).observe(footer);
    }
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-back-to-top]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  });
</script>

<style>
  .back-to-top {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: var(--color-card);
  }

  .circle {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--color-ink-faint);
    transition: background 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .label {
    margin-top: -1.15rem;
    font-size: 1.05rem;
    color: var(--color-card);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
    pointer-events: none;
  }

  @media (hover: hover) {
    .back-to-top:hover .circle {
      background: var(--color-ink-soft);
      transform: translateY(-2px);
    }
  }

  .back-to-top-float {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-card) 92%, transparent);
    color: var(--color-ink);
    box-shadow: var(--shadow-soft);
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
  }

  .back-to-top-float.is-shown {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
</style>
