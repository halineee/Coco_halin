---
// Formulaire de réponse (RSVP). Les réponses sont envoyées au formulaire
// Google (et donc dans son tableau Google Sheets). Réglages dans
// src/content/site.yaml (« rsvp »). Sans adresse de formulaire, rien ne s'affiche.
import site from '../content/site.yaml';
import { fr } from '../lib/text';

// Textes affichés : avec les espaces insécables français.
const rsvp = fr(site.rsvp);
// Valeurs envoyées à Google : recopiées telles quelles (sans retouche),
// sinon Google ne reconnaît pas le choix.
const raw = site.rsvp;
const gf = raw?.googleForm;
const ready = Boolean(gf?.action && gf?.fields?.name && gf?.fields?.attending);
const attendingOptions: string[] = raw?.attendingOptions ?? [];
const airbnbOptions: string[] = raw?.airbnbOptions ?? [];
---

{
  ready && (
    <section class="rsvp container" aria-labelledby="rsvp-title">
      <h2 id="rsvp-title" class="heading script" data-reveal>
        {rsvp.title}
      </h2>
      <p class="intro" data-reveal>
        {rsvp.text}
      </p>

      <form
        class="form"
        data-rsvp
        data-action={gf.action}
        data-fields={JSON.stringify(gf.fields)}
        data-decline={raw.declineOption}
        data-airbnb-default={raw.airbnbDefault}
        data-reveal
      >
        <label class="field">
          <span>Nom et prénom</span>
          <input name="name" type="text" autocomplete="name" required />
        </label>

        <fieldset class="field">
          <legend>Votre réponse</legend>
          <div class="choices stacked">
            {attendingOptions.map((opt, i) => (
              <label>
                <input type="radio" name="attending" value={opt} required={i === 0} />
                <span>{fr(opt)}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="if-coming">
          <label class="field">
            <span>Combien de personnes, vous compris ?</span>
            <input name="guests" type="number" inputmode="numeric" min="1" max="20" value="1" />
          </label>

          {gf.fields.airbnb && airbnbOptions.length > 0 && (
            <fieldset class="field">
              <legend>{rsvp.airbnbQuestion}</legend>
              {rsvp.airbnbNote && <p class="hint">{rsvp.airbnbNote}</p>}
              <div class="choices stacked">
                {airbnbOptions.map((opt) => (
                  <label>
                    <input type="radio" name="airbnb" value={opt} />
                    <span>{fr(opt)}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          )}
        </div>

        <button type="submit" class="submit">Envoyer ma réponse</button>
        <p class="status" role="status" aria-live="polite" data-thanks={rsvp.thanks} data-error={rsvp.error} />
      </form>
    </section>
  )
}

<script>
  const form = document.querySelector<HTMLFormElement>('[data-rsvp]');
  if (form) {
    const fields = JSON.parse(form.dataset.fields || '{}') as Record<string, string>;
    const decline = form.dataset.decline || '';
    const airbnbDefault = form.dataset.airbnbDefault || '';
    const status = form.querySelector<HTMLElement>('.status')!;
    const ifComing = form.querySelector<HTMLElement>('.if-coming')!;
    const airbnbRadios = form.querySelectorAll<HTMLInputElement>('input[name="airbnb"]');

    const declined = () => new FormData(form).get('attending') === decline;

    // Si l'invité ne vient pas, on masque le nombre de personnes et l'hébergement.
    const toggle = () => {
      const no = declined();
      ifComing.hidden = no;
      airbnbRadios.forEach((r, i) => (r.required = !no && i === 0));
    };
    form.addEventListener('change', toggle);
    toggle();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const no = declined();
      // Toutes les questions du formulaire Google sont obligatoires :
      // on envoie des valeurs par défaut quand l'invité ne vient pas.
      const values: Record<string, string> = {
        name: String(data.get('name') || '').trim(),
        attending: String(data.get('attending') || ''),
        guests: no ? '0' : String(data.get('guests') || '1'),
        airbnb: no ? airbnbDefault : String(data.get('airbnb') || airbnbDefault),
      };
      const body = new URLSearchParams();
      for (const [key, entry] of Object.entries(fields)) {
        if (entry && values[key]) body.append(entry, values[key]);
      }
      const button = form.querySelector('button')!;
      button.disabled = true;
      try {
        // Google Forms ne permet pas de lire la réponse : envoi « à l'aveugle ».
        await fetch(form.dataset.action!, { method: 'POST', mode: 'no-cors', body });
        form.classList.add('sent');
        status.textContent = status.dataset.thanks || '';
      } catch {
        status.textContent = status.dataset.error || '';
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .rsvp {
    padding-top: var(--space-2xl);
    text-align: center;
  }

  .heading {
    font-size: var(--text-script-sm);
  }

  .intro {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .form {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    padding: var(--space-lg) var(--space-md);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-card);
    text-align: left;
  }

  .if-coming {
    display: grid;
    gap: var(--space-md);
  }

  .if-coming[hidden] {
    display: none;
  }

  .field {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    border: 0;
    font-size: var(--text-sm);
  }

  .field > span,
  legend {
    padding: 0;
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    line-height: 1.6;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  legend {
    margin-bottom: 0.4rem;
  }

  .hint {
    margin-bottom: 0.3rem;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  input[type='text'],
  input[type='number'] {
    width: 100%;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-paper);
    color: var(--color-ink);
    font: inherit;
    font-size: 1rem; /* évite le zoom automatique sur iPhone */
  }

  input[type='number'] {
    max-width: 6rem;
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .choices.stacked {
    flex-direction: column;
    align-items: flex-start;
  }

  .choices label {
    position: relative;
  }

  .choices input {
    position: absolute;
    opacity: 0;
  }

  .choices span {
    display: inline-block;
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: var(--text-sm);
    line-height: 1.4;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }

  .choices input:checked + span {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-card);
  }

  .choices input:focus-visible + span {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .submit {
    justify-self: center;
    margin-top: var(--space-xs);
    padding: 0.8rem 1.6rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-card);
    font: inherit;
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .submit:disabled {
    opacity: 0.5;
  }

  .status {
    text-align: center;
    font-size: var(--text-sm);
  }

  .status:empty {
    display: none;
  }

  /* Après l'envoi, on ne garde que le message de remerciement */
  .sent > :not(.status) {
    display: none;
  }

  .sent .status {
    font-size: 1rem;
    line-height: 1.6;
  }
</style>
