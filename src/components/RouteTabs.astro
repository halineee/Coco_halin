---
// Itinéraires vers le lieu du mariage, présentés en onglets
// (Depuis l'aéroport / le centre / votre hôtel). Chaque itinéraire
// est une suite d'étapes numérotées.
// Sans JavaScript, tous les itinéraires s'affichent les uns sous les autres.
import Icon from './Icon.astro';
import { isTodo } from '../lib/text';

interface Route {
  id: string;
  label: string;
  duration?: string;
  steps: { title: string; text: string }[];
  alternative?: string;
}
interface Props {
  routes: Route[];
}
const { routes } = Astro.props;
---

<div class="route-tabs" data-tabs>
  <div class="tablist" role="tablist" aria-label="Point de départ" hidden data-tablist>
    {
      routes.map((route, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${route.id}`}
          aria-controls={`panel-${route.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {route.label}
        </button>
      ))
    }
  </div>

  {
    routes.map((route) => (
      <section class="panel" role="tabpanel" id={`panel-${route.id}`} aria-labelledby={`tab-${route.id}`}>
        <header class="panel-head">
          <h3 class="panel-title">{route.label}</h3>
          {route.duration && (
            <p class="duration">
              <Icon name="clock" size={16} strokeWidth={1.4} /> {route.duration}
            </p>
          )}
        </header>
        <ol class="steps">
          {route.steps.map((step) => (
            <li class:list={{ todo: isTodo(step.text) }}>
              <p class="step-title">{step.title}</p>
              <p class="step-text">{step.text}</p>
            </li>
          ))}
        </ol>
        {route.alternative && (
          <p class="alternative">
            <Icon name="taxi" size={20} strokeWidth={1.2} />
            <span>{route.alternative}</span>
          </p>
        )}
      </section>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tablist = root.querySelector<HTMLElement>('[data-tablist]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    tablist.hidden = false;
    root.classList.add('is-enhanced');

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[i].hidden = !selected;
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') select((i + 1) % tabs.length, true);
        if (event.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
      });
    });

    select(0);
  });
</script>

<style>
  .tablist {
    display: flex;
    gap: 0.4rem;
    margin-bottom: var(--space-md);
    padding: 0.3rem;
    border-radius: 999px;
    background: var(--color-paper-deep);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tablist::-webkit-scrollbar {
    display: none;
  }

  [role='tab'] {
    flex: 1 0 auto;
    min-height: 40px;
    padding: 0 0.9rem;
    border: 0;
    border-radius: 999px;
    background: none;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.3s var(--ease), color 0.3s var(--ease);
  }

  [role='tab'][aria-selected='true'] {
    background: var(--color-card);
    color: var(--color-ink);
    box-shadow: 0 2px 8px -4px rgb(60 58 70 / 0.3);
  }

  .panel {
    padding: var(--space-md);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-card);
  }

  .panel + .panel {
    margin-top: var(--space-md);
  }

  .is-enhanced .panel + .panel {
    margin-top: 0;
  }

  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .panel-title {
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  /* Le titre est déjà dans l'onglet quand celui-ci est visible */
  .is-enhanced .panel-title {
    display: none;
  }

  .duration {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .steps {
    counter-reset: step;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    position: relative;
    padding: 0 0 var(--space-md) 2.6rem;
    counter-increment: step;
  }

  .steps li:last-child {
    padding-bottom: 0;
  }

  /* Numéro de l'étape */
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -0.1rem;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--color-ink-soft);
    border-radius: 50%;
    background: var(--color-card);
    font-size: var(--text-xs);
    color: var(--color-ink);
  }

  /* Trait vertical qui relie les étapes */
  .steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 0.87rem;
    top: 1.75rem;
    bottom: 0.1rem;
    width: 1px;
    background: var(--color-line);
  }

  .step-title {
    font-weight: 400;
    line-height: 1.4;
  }

  .step-text {
    margin-top: 0.2rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .todo .step-text {
    font-style: italic;
    color: var(--color-ink-faint);
  }

  .alternative {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .alternative :global(svg) {
    flex: none;
    margin-top: 0.05rem;
  }
</style>
