---
// Carte cliquable d'une destination (page d'accueil du carnet).
import { Image } from 'astro:assets';
import { getImage } from '../lib/images';
import Icon from './Icon.astro';

interface Props {
  href: string;
  index?: number;
  name: string;
  korean?: string;
  text: string;
  image: string;
  label?: string;
}
const { href, index, name, korean, text, image, label } = Astro.props;
const photo = getImage(image);
---

<a class="destination-card" href={href} data-reveal>
  <div class="media">
    <Image src={photo} alt="" widths={[480, 800, 1100]} sizes="(min-width: 48em) 45vw, 100vw" loading="lazy" />
  </div>
  <div class="body">
    <p class="eyebrow">{label ?? (index !== undefined ? String(index).padStart(2, '0') : '')}</p>
    <h3 class="script">{name}</h3>
    {korean && <p class="korean" lang="ko">{korean}</p>}
    <p class="text">{text}</p>
    <span class="cta">Découvrir <Icon name="arrow-right" size={16} strokeWidth={1.3} /></span>
  </div>
</a>

<style>
  .destination-card {
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-card);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }

  .media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-paper-deep);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }

  .body {
    padding: var(--space-md);
  }

  h3 {
    margin-top: 0.2rem;
    font-size: var(--text-script-md);
    line-height: 1.1;
  }

  .korean {
    margin-top: 0.15rem;
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    color: var(--color-ink-soft);
  }

  .text {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: var(--space-sm);
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .cta :global(svg) {
    transition: transform 0.3s var(--ease);
  }

  @media (hover: hover) {
    .destination-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-soft);
    }

    .destination-card:hover .media :global(img) {
      transform: scale(1.04);
    }

    .destination-card:hover .cta :global(svg) {
      transform: translateX(4px);
    }
  }
</style>
