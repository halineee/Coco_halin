---
// Icônes dessinées au trait (SVG). Pour modifier un dessin, changez le
// contenu de l'icône correspondante ci-dessous.
interface Props {
  name: 'rings' | 'polaroid' | 'plane' | 'hotel' | 'map' | 'heart' | 'arrow-up' | 'arrow-right' | 'external' | 'pin' | 'copy';
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 32, strokeWidth = 1.1, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'rings' && (
      <>
        <circle cx="12.4" cy="19.8" r="6.3" />
        <circle cx="19.6" cy="19.8" r="6.3" />
        <path d="M10 10.4h4.8l1.3 1.5-3.7 2.9-3.7-2.9zM8.7 11.9h7.4" />
        <path d="M6.8 7.6l1 1M18 7.6l-1 1M12.4 6v1.4" />
      </>
    )
  }
  {
    name === 'polaroid' && (
      <g transform="rotate(-9 16 16)">
        <rect x="7.2" y="5.6" width="17.6" height="21.2" rx="0.8" />
        <rect x="9.4" y="7.8" width="13.2" height="12.4" rx="0.3" />
        <path d="M16 17.6c-2.6-1.8-3.7-3-3.7-4.4a1.85 1.85 0 0 1 3.7-.5 1.85 1.85 0 0 1 3.7.5c0 1.4-1.1 2.6-3.7 4.4z" />
        <path d="M11.5 23.6c1.2-.6 2.2.6 3.4 0s2.2.6 3.4 0" />
      </g>
    )
  }
  {
    name === 'plane' && (
      <>
        <path d="M3.6 17.2c3.4-1.9 16-3.2 21.6-2.6 2.6.3 3.6 1.4 3 2.3-.5.8-2.3 1.2-4.6 1.4-6.2.5-14.2.4-18.6-.1z" />
        <path d="M5.4 16.6 3.8 11.6h2.3l3.6 4.4" />
        <path d="M13.2 18.4 10 23.4h2.4l6.6-5.1" />
        <path d="M14.6 15.2 12.4 12h1.9l4.4 2.7" />
        <path d="M24.4 15.1c.9.2 1.6.7 1.9 1.3" />
        <path d="M12 16.6h.01M14 16.5h.01M16 16.4h.01M18 16.3h.01M20 16.3h.01" stroke-width="1.6" />
        <path d="M1.8 20.6h4M2.8 22.4h2.6" opacity="0.6" />
      </>
    )
  }
  {
    name === 'hotel' && (
      <>
        <rect x="8.6" y="7.6" width="14.8" height="20" rx="0.4" />
        <rect x="11.2" y="4" width="9.6" height="3.6" rx="0.3" />
        <path d="M12.6 5.8h6.8" stroke-dasharray="0.6 0.9" />
        <path d="M11.2 10.6h1.8v1.8h-1.8zM15.1 10.6h1.8v1.8h-1.8zM19 10.6h1.8v1.8H19zM11.2 14.4h1.8v1.8h-1.8zM15.1 14.4h1.8v1.8h-1.8zM19 14.4h1.8v1.8H19zM11.2 18.2h1.8V20h-1.8zM15.1 18.2h1.8V20h-1.8zM19 18.2h1.8V20H19z" />
        <path d="M14 27.6v-4.4h4v4.4M16 23.2v4.4M6.6 27.6h18.8" />
      </>
    )
  }
  {
    name === 'map' && (
      <>
        <path d="M4.6 8.4 11.4 6l9.2 2.6L27.4 6v18.4l-6.8 2.4-9.2-2.6-6.8 2.4z" />
        <path d="M11.4 6v18.2M20.6 8.6v18.2" />
        <path d="M7.4 21.4c1.6-1.4 3.2-2 5.2-1.2s3.4 1 4.8-.6 1.8-3.4 3.6-4" stroke-dasharray="1 1.4" />
        <path d="M23.4 15.4c-1.8-1.9-2.7-3.3-2.7-4.6a2.7 2.7 0 0 1 5.4 0c0 1.3-.9 2.7-2.7 4.6z" />
        <circle cx="23.4" cy="10.8" r="0.9" />
      </>
    )
  }
  {
    name === 'heart' && (
      <path d="M16 25.5c-6.6-4.6-9.6-7.9-9.6-11.4a4.8 4.8 0 0 1 9.6-1.3 4.8 4.8 0 0 1 9.6 1.3c0 3.5-3 6.8-9.6 11.4z" />
    )
  }
  {
    name === 'arrow-up' && <path d="M16 26V7M9 13.5 16 6.5l7 7" />
  }
  {
    name === 'arrow-right' && <path d="M6 16h19M18.5 9l7 7-7 7" />
  }
  {
    name === 'external' && <path d="M13 8H8.5A1.5 1.5 0 0 0 7 9.5v14A1.5 1.5 0 0 0 8.5 25h14a1.5 1.5 0 0 0 1.5-1.5V19M18 7h7v7M25 7 14.5 17.5" />
  }
  {
    name === 'pin' && (
      <>
        <path d="M16 28c-5.4-5.6-8-9.6-8-13.2a8 8 0 0 1 16 0c0 3.6-2.6 7.6-8 13.2z" />
        <circle cx="16" cy="14.6" r="2.8" />
      </>
    )
  }
  {
    name === 'copy' && (
      <>
        <rect x="11" y="11" width="14" height="15" rx="1.5" />
        <path d="M21 11V7.5A1.5 1.5 0 0 0 19.5 6h-11A1.5 1.5 0 0 0 7 7.5v12A1.5 1.5 0 0 0 8.5 21H11" />
      </>
    )
  }
</svg>
