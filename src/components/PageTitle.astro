---
// Grand titre manuscrit en haut des pages (« Photos », « Transports »…).
// Si `art` est fourni (dessin du titre, dans src/assets/illustrations/titres/),
// il remplace le texte à l'écran ; le texte reste lu par les lecteurs d'écran.
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  art?: ImageMetadata;
  eyebrow?: string;
  intro?: string;
}
const { title, art, eyebrow, intro } = Astro.props;
---

<div class="page-title container container--wide">
  {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
  {
    art ? (
      <h1 class="art" data-reveal>
        <span class="visually-hidden">{title}</span>
        <img src={art.src} width={art.width} height={art.height} alt="" />
      </h1>
    ) : (
      <h1 class="script" data-reveal>{title}</h1>
    )
  }
  {intro && <p class="intro" data-reveal style="--reveal-delay: 0.12s">{intro}</p>}
</div>

<style>
  .page-title {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-lg);
  }

  .eyebrow {
    margin-bottom: var(--space-sm);
  }

  h1 {
    font-size: var(--text-script-lg);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin-left: -0.05em;
  }

  .art img {
    display: block;
    width: auto;
    height: clamp(3.6rem, 2.8rem + 3vw, 5.25rem);
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
    margin-left: -0.2rem;
  }

  .intro {
    max-width: 30rem;
    margin-top: var(--space-md);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
</style>
