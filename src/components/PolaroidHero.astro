---
// Ouverture de la page d'accueil : titre, polaroid, ruban adhésif et
// illustrations. Les dessins sont dans src/assets/illustrations/ :
// remplacez simplement un fichier (même nom) pour changer un élément.
import { Image } from 'astro:assets';
import site from '../content/site.yaml';
import { getImage } from '../lib/images';
import titleArt from '../assets/illustrations/getting-married.svg';
import heartLine from '../assets/illustrations/heart-line.svg';
import bouquet from '../assets/illustrations/bouquet-envelope.svg';
import tape from '../assets/illustrations/washi-tape.png';

const [line1, line2] = site.home.heroTitle;
const photo = getImage(site.home.heroPhoto);
---

<section class="hero" aria-label={`${line1} ${line2} — ${site.couple.names}`}>
  <div class="stage">
    <h1 class="title">
      <span class="visually-hidden">{line1} {line2} — {site.couple.names}</span>
      <img src={titleArt.src} alt="" width={titleArt.width} height={titleArt.height} />
    </h1>

    <img class="heart-line" src={heartLine.src} alt="" width={heartLine.width} height={heartLine.height} />

    <figure class="polaroid">
      <Image class="tape" src={tape} alt="" widths={[220, 440]} sizes="160px" loading="eager" />
      <Image
        class="photo"
        src={photo}
        alt={site.home.heroPhotoAlt}
        widths={[360, 560, 800]}
        sizes="(min-width: 40em) 260px, 46vw"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>{site.couple.names}</figcaption>
    </figure>

    <img class="bouquet" src={bouquet.src} alt="" width={bouquet.width} height={bouquet.height} loading="lazy" />
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-xl);
    padding-inline: var(--gutter);
  }

  .stage {
    position: relative;
    container-type: inline-size;
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    aspect-ratio: 1 / 1.06;
  }

  .stage img {
    display: block;
    height: auto;
  }

  /* Titre « Getting Married » (déjà incliné dans le dessin) */
  .title {
    position: absolute;
    z-index: 3;
    top: 0;
    left: 27%;
    width: 72%;
    margin: 0;
    pointer-events: none;
  }

  .title img {
    width: 100%;
  }

  /* Trait au cœur : sa fin glisse sous le polaroid */
  .heart-line {
    position: absolute;
    z-index: 1;
    top: 9%;
    left: -6%;
    width: 50%;
    transform: rotate(14deg);
    transform-origin: left center;
  }

  /* Polaroid */
  .polaroid {
    position: absolute;
    z-index: 2;
    top: 33%;
    left: 0;
    width: 50%;
    margin: 0;
    padding: 4.2% 4.2% 0;
    background: var(--color-card);
    box-shadow: var(--shadow-lift);
    transform: rotate(-11deg);
  }

  .polaroid :global(.photo) {
    width: 100%;
    aspect-ratio: 1 / 1.08;
    object-fit: cover;
  }

  /* Légende : même inclinaison que la photo (héritée du polaroid) */
  .polaroid figcaption {
    padding: 0.35em 0 0.45em;
    text-align: center;
    font-family: var(--font-hand);
    font-size: 6.4cqi;
    white-space: nowrap;
    line-height: 1.3;
    color: var(--color-ink-soft);
  }

  /* Ruban adhésif en papier */
  .polaroid :global(.tape) {
    position: absolute;
    z-index: 1;
    top: -7%;
    left: 50%;
    width: 62%;
    transform: translateX(-50%) rotate(4deg);
    filter: drop-shadow(0 1px 1.5px rgb(60 58 70 / 0.14));
  }

  /* Bouquet + enveloppe : glissé en partie sous le polaroid */
  .bouquet {
    position: absolute;
    z-index: 1;
    right: -5%;
    bottom: 0;
    width: 64%;
    opacity: 0.9;
  }

  /* Animation d'entrée très légère */
  @media (prefers-reduced-motion: no-preference) {
    .polaroid {
      animation: drop-in 1.1s var(--ease) both 0.15s;
    }
    .title {
      animation: fade-in 1.3s var(--ease) both 0.4s;
    }
    .bouquet,
    .heart-line {
      animation: fade-in 1.6s var(--ease) both 0.8s;
    }
  }

  @keyframes drop-in {
    from {
      opacity: 0;
      transform: translateY(-14px) rotate(-6deg);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
</style>
