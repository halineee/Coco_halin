---
// Ouverture de la page d'accueil : titre manuscrit, polaroid et illustration.
import { Image } from 'astro:assets';
import site from '../content/site.yaml';
import { getImage } from '../lib/images';
import BouquetIllustration from './BouquetIllustration.astro';
import HeartScribble from './HeartScribble.astro';

const [line1, line2] = site.home.heroTitle;
const photo = getImage(site.home.heroPhoto);
---

<section class="hero" aria-label={`${line1} ${line2} — ${site.couple.names}`}>
  <div class="stage">
    <HeartScribble class="scribble" />
    <h1 class="title script">
      <span class="line line-1">{line1}</span>
      <span class="line line-2">{line2}</span>
    </h1>

    <figure class="polaroid">
      <span class="tape" aria-hidden="true"></span>
      <Image
        src={photo}
        alt={site.home.heroPhotoAlt}
        widths={[360, 560, 800]}
        sizes="(min-width: 40em) 260px, 46vw"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="script">{site.couple.names}</figcaption>
    </figure>

    <BouquetIllustration class="bouquet" />
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-lg);
    padding-inline: var(--gutter);
  }

  .stage {
    position: relative;
    container-type: inline-size;
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    aspect-ratio: 1 / 0.98;
  }

  /* Titre */
  .title {
    position: absolute;
    inset: 0;
    z-index: 3;
    font-size: 25cqi;
    color: var(--color-ink);
    pointer-events: none;
  }

  .line {
    position: absolute;
    white-space: nowrap;
    opacity: 0.88;
  }

  .line-1 {
    top: 0;
    left: 27%;
    transform: rotate(-4deg);
  }

  .line-2 {
    top: 21%;
    left: 40%;
    transform: rotate(-4deg);
  }

  .stage :global(.scribble) {
    position: absolute;
    top: 13%;
    left: 0;
    width: 34%;
    color: var(--color-ink-faint);
  }

  /* Polaroid */
  .polaroid {
    position: absolute;
    z-index: 2;
    top: 30%;
    left: 0;
    width: 50%;
    padding: 4.2% 4.2% 0;
    background: var(--color-card);
    box-shadow: var(--shadow-lift);
    transform: rotate(-11deg);
  }

  .polaroid img {
    width: 100%;
    aspect-ratio: 1 / 1.08;
    object-fit: cover;
  }

  .polaroid figcaption {
    padding: 0.55em 0 0.6em;
    text-align: center;
    font-size: 7cqi;
    color: var(--color-ink-soft);
    transform: rotate(-4deg);
  }

  .tape {
    position: absolute;
    top: -5%;
    left: 50%;
    width: 42%;
    height: 9%;
    background: rgb(196 198 178 / 0.78);
    transform: translateX(-50%) rotate(2deg);
    clip-path: polygon(3% 0, 97% 4%, 100% 30%, 97% 60%, 100% 100%, 2% 96%, 0 65%, 3% 35%);
  }

  .stage :global(.bouquet) {
    position: absolute;
    z-index: 1;
    right: -3%;
    bottom: 3%;
    width: 58%;
    color: var(--color-ink-soft);
  }

  /* Animation d'entrée très légère */
  @media (prefers-reduced-motion: no-preference) {
    .polaroid {
      animation: drop-in 1.1s var(--ease) both 0.15s;
    }
    .line-1 {
      animation: fade-in 1.2s var(--ease) both 0.35s;
    }
    .line-2 {
      animation: fade-in 1.2s var(--ease) both 0.6s;
    }
    .stage :global(.bouquet),
    .stage :global(.scribble) {
      animation: fade-in 1.6s var(--ease) both 0.8s;
    }
  }

  @keyframes drop-in {
    from {
      opacity: 0;
      transform: translateY(-14px) rotate(-6deg);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
</style>
