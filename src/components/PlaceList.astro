---
// Liste numérotée de lieux, plats ou activités (pages du carnet).
import type { Place } from '../lib/destinations';
import { Image } from 'astro:assets';
import MapChips from './MapChips.astro';
import { getImage } from '../lib/images';

interface Props {
  items: Place[];
  /** Ville en coréen, ajoutée à la recherche (ex. « 부산 ») */
  city?: string;
  /** Afficher les liens de carte pour tous les éléments ayant un nom coréen */
  maps?: boolean;
}
const { items, city, maps = false } = Astro.props;

const queryFor = (item: Place) => {
  if (item.recherche) return item.recherche;
  if (!item.korean) return undefined;
  const ko = item.korean.split('·')[0].trim();
  return city && !ko.includes(city) ? `${city} ${ko}` : ko;
};
const showMap = (item: Place) => (item.carte ?? maps) && !!queryFor(item);
---

<ol class="place-list">
  {
    items.map((item, i) => (
      <li class:list={{ 'has-photo': !!item.photo }} data-reveal style={`--reveal-delay: ${(i % 4) * 0.06}s`}>
        <span class="num">{String(i + 1).padStart(2, '0')}</span>
        {item.photo && (
          <div class="photo">
            <Image src={getImage(item.photo)} alt={item.name} widths={[480, 800]} sizes="(min-width: 48em) 30rem, 85vw" loading="lazy" />
          </div>
        )}
        <div class="content">
          <h4>
            {item.name}
            {item.korean && (
              <span class="korean" lang="ko">
                {item.korean}
              </span>
            )}
          </h4>
          <p>{item.text}</p>
          {showMap(item) && <MapChips query={queryFor(item)!} label={item.name} />}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .place-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: var(--space-xs);
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-line);
  }

  li:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .photo {
    grid-column: 2;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin-bottom: var(--space-xs);
    border-radius: var(--radius-md);
    background: var(--color-paper-deep);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .content {
    grid-column: 2;
  }

  .num {
    grid-row: 1;
    padding-top: 0.2rem;
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--color-ink-soft);
  }

  h4 {
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.35;
  }

  .korean {
    margin-left: 0.45rem;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    white-space: nowrap;
  }

  p {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
</style>
