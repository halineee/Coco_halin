---
// Carte d'un hôtel : photo, nom, quartier, description, gamme de prix,
// accès et lien. Toute la carte est cliquable quand un lien est fourni.
// Si le nom commence par « À compléter », la carte s'affiche comme provisoire.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { getImage } from '../lib/images';
import { isTodo } from '../lib/text';

interface Props {
  name: string;
  neighborhood?: string;
  image?: string;
  description?: string;
  price?: string;
  transport?: string;
  url?: string;
}
const { name, neighborhood, image, description, price, transport, url } = Astro.props;

const todo = isTodo(name);
const photo = image ? getImage(image) : undefined;
// Sans lien fourni, on ouvre l'hôtel dans Google Maps
const href = url || (todo ? '' : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${name} Seoul`)}`);
const Tag = href ? 'a' : 'article';
const linkProps = Tag === 'a' ? { href, target: '_blank', rel: 'noopener noreferrer' } : {};
const ctaLabel = url ? 'Voir l’hôtel' : 'Voir sur la carte';
---

<Tag class:list={['hotel', { todo, link: Tag === 'a' }]} {...linkProps} data-reveal>
  {
    photo && (
      <div class="media">
        <Image src={photo} alt="" widths={[400, 700, 1000]} sizes="(min-width: 56em) 30vw, (min-width: 40em) 45vw, 100vw" loading="lazy" />
      </div>
    )
  }
  <div class="body">
    <div class="top">
      {neighborhood ? <p class="eyebrow">{neighborhood}</p> : <span />}
      {price && <span class="price" aria-label={`Gamme de prix : ${price}`}>{price}</span>}
    </div>
    <h3>{todo ? 'Hôtel à venir' : name}</h3>
    {description && !isTodo(description) && <p class="description">{description}</p>}
    {
      transport && !isTodo(transport) && (
        <p class="transport">
          <Icon name="metro" size={18} strokeWidth={1.3} /> {transport}
        </p>
      )
    }
    {
      Tag === 'a' && (
        <span class="cta">
          {ctaLabel} <Icon name="external" size={14} strokeWidth={1.6} />
        </span>
      )
    }
    {todo && <p class="todo-note">Informations à venir</p>}
  </div>
</Tag>

<style>
  .hotel {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-card);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }

  .media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-paper-deep);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .price {
    flex: none;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--color-paper-deep);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.4rem;
    padding: var(--space-md);
  }

  h3 {
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .description {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .transport {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.2rem;
    font-size: var(--text-sm);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: var(--space-xs);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* Carte provisoire */
  .todo {
    border-style: dashed;
    background: transparent;
  }

  .todo .media :global(img) {
    opacity: 0.55;
    filter: grayscale(0.4);
  }

  .todo h3 {
    color: var(--color-ink-soft);
  }

  .todo-note {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-ink-faint);
  }

  @media (hover: hover) {
    .link:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-soft);
    }

    .link:hover .media :global(img) {
      transform: scale(1.04);
    }
  }
</style>
