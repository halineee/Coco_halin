---
// Compte à rebours « Plus que XXX jours ». Le nombre est recalculé chaque
// jour directement dans le navigateur du visiteur.
interface Props {
  datetime: string;
  before: string;
  after: string;
  today: string;
}
const { datetime, before, after, today } = Astro.props;

const daysLeft = (target: Date) => Math.max(0, Math.ceil((target.getTime() - Date.now()) / 86_400_000));
const initial = daysLeft(new Date(datetime));
---

<section class="countdown container" data-countdown={datetime} data-today={today} data-reveal>
  <p class="before script">{before}</p>
  <p class="number">
    <span class="digits" data-days>{initial}</span>
    <span class="unit script">jours</span>
  </p>
  <p class="after script">{after}</p>
</section>

<script>
  const el = document.querySelector<HTMLElement>('[data-countdown]');
  if (el) {
    const target = new Date(el.dataset.countdown!);
    const days = Math.ceil((target.getTime() - Date.now()) / 86_400_000);
    const out = el.querySelector('[data-days]');
    if (days <= 0) {
      el.innerHTML = `<p class="script" style="font-size: var(--text-script-sm)">${el.dataset.today}</p>`;
    } else if (out) {
      out.textContent = String(days);
    }
  }
</script>

<style>
  .countdown {
    padding-top: var(--space-2xl);
    text-align: center;
  }

  .before,
  .after,
  .unit {
    font-size: var(--text-script-sm);
  }

  .before,
  .after,
  .number {
    line-height: 1.15;
  }

  .number {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 0.55rem;
  }

  .digits {
    font-family: var(--font-script);
    font-size: var(--text-script-md);
    letter-spacing: 0.04em;
  }
</style>
