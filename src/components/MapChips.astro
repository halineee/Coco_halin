---
// Trois petits liens vers Naver Map, Kakao Map et Google Maps pour un lieu.
// La recherche se fait en coréen (plus fiable dans les applications locales).
interface Props {
  query: string;
  label?: string;
}
const { query, label } = Astro.props;
const q = encodeURIComponent(query);
const links = [
  { name: 'Naver', cls: 'naver', href: `https://map.naver.com/p/search/${q}` },
  { name: 'Kakao', cls: 'kakao', href: `https://map.kakao.com/link/search/${q}` },
  { name: 'Google', cls: 'google', href: `https://www.google.com/maps/search/?api=1&query=${q}` },
];
---

<ul class="map-chips" aria-label={label ? `Voir ${label} sur une carte` : 'Voir sur une carte'}>
  {
    links.map((l) => (
      <li>
        <a class={l.cls} href={l.href} target="_blank" rel="noopener noreferrer">
          <span class="dot" aria-hidden="true" />
          {l.name}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .map-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 32px;
    padding: 0 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--color-ink-soft);
    background: var(--color-card);
    transition: border-color 0.3s var(--ease), color 0.3s var(--ease);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }

  .naver .dot {
    background: #03c75a;
  }

  .kakao .dot {
    background: #fee500;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }

  .google .dot {
    background: #4285f4;
  }

  @media (hover: hover) {
    a:hover {
      border-color: var(--color-ink-soft);
      color: var(--color-ink);
    }
  }
</style>
