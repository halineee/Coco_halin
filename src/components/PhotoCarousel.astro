---
// Carrousel « à la Canva » : une photo au centre, les voisines qui
// dépassent sur les côtés avec un bord de papier déchiré.
// Glisser du doigt (mobile) ou utiliser les flèches ; toucher la photo
// centrale l'ouvre en plein écran.
import { Image } from 'astro:assets';
import type { GalleryPhoto } from '../lib/gallery';
import Icon from './Icon.astro';

interface Props {
  photos: GalleryPhoto[];
  label: string;
}
const { photos, label } = Astro.props;

// Bord déchiré : un contour irrégulier sur les côtés gauche et droit,
// utilisé comme masque sur les photos latérales.
function tornMask() {
  const steps = 46;
  const left: string[] = [];
  const right: string[] = [];
  for (let i = 0; i <= steps; i++) {
    const y = (i / steps) * 100;
    const jitter = (seed: number) => (Math.sin(seed * 12.9898) * 43758.5453) % 1;
    left.push(`${(1.2 + Math.abs(jitter(i + 1)) * 2.6).toFixed(2)} ${y.toFixed(2)}`);
    right.push(`${(98.8 - Math.abs(jitter(i + 101)) * 2.6).toFixed(2)} ${(100 - y).toFixed(2)}`);
  }
  const d = `M${left.join(' L')} L${right.join(' L')} Z`;
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' preserveAspectRatio='none'><path d='${d}' fill='black'/></svg>`;
  return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
}
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="carousel" data-carousel style={`--torn: ${tornMask()}`}>
  <ul class="track" data-lightbox aria-label={label}>
    {
      photos.map((photo, i) => (
        <li class:list={['slide', { 'is-active': i === 0 }]}>
          <a href={photo.full.src} data-pswp-width={photo.full.width} data-pswp-height={photo.full.height}>
            <Image
              src={photo.image}
              alt={photo.alt}
              widths={[400, 640, 900]}
              sizes="(min-width: 48em) 22rem, 68vw"
              loading={i < 2 ? 'eager' : 'lazy'}
            />
          </a>
        </li>
      ))
    }
  </ul>

  {
    photos.length > 1 && (
      <div class="controls">
        <button type="button" class="arrow prev" data-prev aria-label="Photo précédente">
          <Icon name="arrow-right" size={20} strokeWidth={1.2} />
        </button>
        <p class="counter" aria-live="polite">
          <span data-current>01</span> / {pad(photos.length)}
        </p>
        <button type="button" class="arrow" data-next aria-label="Photo suivante">
          <Icon name="arrow-right" size={20} strokeWidth={1.2} />
        </button>
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('.track')!;
    const slides = [...carousel.querySelectorAll<HTMLElement>('.slide')];
    const current = carousel.querySelector('[data-current]');
    let active = 0;

    const centerOf = (slide: HTMLElement) => slide.offsetLeft + slide.offsetWidth / 2;

    const update = () => {
      const middle = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      slides.forEach((slide, i) => {
        if (Math.abs(centerOf(slide) - middle) < Math.abs(centerOf(slides[best]) - middle)) best = i;
      });
      if (best === active && slides[best].classList.contains('is-active')) return;
      active = best;
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === best));
      if (current) current.textContent = String(best + 1).padStart(2, '0');
    };

    const goTo = (index: number) => {
      const slide = slides[Math.max(0, Math.min(slides.length - 1, index))];
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollTo({ left: centerOf(slide) - track.clientWidth / 2, behavior: reduce ? 'auto' : 'smooth' });
    };

    let frame = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    }, { passive: true });

    carousel.querySelector('[data-prev]')?.addEventListener('click', () => goTo(active - 1));
    carousel.querySelector('[data-next]')?.addEventListener('click', () => goTo(active + 1));

    // Toucher une photo latérale la ramène au centre (au lieu de l'ouvrir)
    slides.forEach((slide, i) => {
      slide.addEventListener('click', (event) => {
        if (i !== active) {
          event.preventDefault();
          event.stopPropagation();
          goTo(i);
        }
      }, true);
    });

    // Comme dans la maquette : on démarre sur la 2e photo pour que
    // des photos dépassent des deux côtés.
    if (slides.length > 2) {
      track.scrollLeft = centerOf(slides[1]) - track.clientWidth / 2;
    }
    update();
  });
</script>

<style>
  .carousel {
    --slide-w: min(68vw, 22rem);
    --gap: 0.9rem;
    position: relative;
  }

  .track {
    display: flex;
    gap: var(--gap);
    margin: 0;
    padding: var(--space-md) 0 var(--space-lg);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  /* Espaces de début et de fin pour pouvoir centrer la première et la dernière photo */
  .track::before,
  .track::after {
    content: '';
    flex: 0 0 calc((100% - var(--slide-w)) / 2 - var(--gap));
  }

  .slide {
    flex: 0 0 var(--slide-w);
    scroll-snap-align: center;
    transform: scale(0.88);
    opacity: 0.7;
    transition:
      transform 0.6s var(--ease),
      opacity 0.6s var(--ease);
  }

  .slide a {
    display: block;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .slide :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    -webkit-mask: var(--torn) center / 100% 100% no-repeat;
    mask: var(--torn) center / 100% 100% no-repeat;
  }

  .slide.is-active {
    transform: none;
    opacity: 1;
  }

  .slide.is-active :global(img) {
    border-radius: var(--radius-md);
    -webkit-mask: none;
    mask: none;
    box-shadow: var(--shadow-soft);
  }

  .slide.is-active a {
    cursor: zoom-in;
  }

  /* Flèches + compteur */
  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: color 0.3s var(--ease), background 0.3s var(--ease);
  }

  .prev :global(svg) {
    transform: scaleX(-1);
  }

  @media (hover: hover) {
    .arrow:hover {
      color: var(--color-ink);
      background: var(--color-paper-deep);
    }
  }

  .counter {
    min-width: 5rem;
    text-align: center;
    font-size: var(--text-xs);
    letter-spacing: 0.24em;
    color: var(--color-ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .slide {
      transition: none;
    }
  }
</style>
